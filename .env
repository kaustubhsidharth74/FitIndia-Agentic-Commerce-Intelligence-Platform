# ── Razorpay Test Keys ──────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Anthropic / Claude ───────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Groq (free LLM for campaign agent) ──────────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=

# ── Mock flags (set false when real APIs are reachable) ──────────────
MOCK_RAZORPAY=true
MOCK_AI=true

# ── Campaign Orchestrator ─────────────────────────────────────────────
# Min age in hours before a pending order is targeted for recovery.
# Set to 0 during development to process all pending orders immediately.
CAMPAIGN_MIN_AGE_HOURS=0

# ── Server ───────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
